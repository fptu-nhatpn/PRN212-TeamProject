<Window x:Class="HorseCare.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="StableCare | Quản lý ngựa"
        Height="820"
        Width="1380"
        MinHeight="700"
        MinWidth="1120"
        WindowStartupLocation="CenterScreen"
        Background="#F6F4FA"
        Loaded="MainWindow_Loaded">
    <Window.Resources>
        <SolidColorBrush x:Key="Purple" Color="#7047EB" />
        <SolidColorBrush x:Key="Ink" Color="#241A35" />
        <SolidColorBrush x:Key="Muted" Color="#82798F" />
        <SolidColorBrush x:Key="Line" Color="#ECE8F2" />

        <Style x:Key="NavButton" TargetType="Button">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="#D8D0E7" />
            <Setter Property="Padding" Value="16,12" />
            <Setter Property="Margin" Value="0,3" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="HorizontalContentAlignment" Value="Left" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="Cursor" Value="Hand" />
        </Style>
        <Style x:Key="Field" TargetType="TextBox">
            <Setter Property="Height" Value="38" />
            <Setter Property="Padding" Value="10,7" />
            <Setter Property="Margin" Value="0,4,0,12" />
            <Setter Property="BorderBrush" Value="#DED8E9" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>
        <Style x:Key="FieldCombo" TargetType="ComboBox">
            <Setter Property="Height" Value="38" />
            <Setter Property="Padding" Value="8,4" />
            <Setter Property="Margin" Value="0,4,0,12" />
            <Setter Property="BorderBrush" Value="#DED8E9" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>
        <Style x:Key="PrimaryButton" TargetType="Button">
            <Setter Property="Background" Value="{StaticResource Purple}" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="Padding" Value="16,10" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Cursor" Value="Hand" />
        </Style>
        <Style TargetType="DataGrid">
            <Setter Property="Background" Value="White" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="RowBackground" Value="White" />
            <Setter Property="AlternatingRowBackground" Value="#FAF9FC" />
            <Setter Property="GridLinesVisibility" Value="Horizontal" />
            <Setter Property="HorizontalGridLinesBrush" Value="#F0EDF4" />
            <Setter Property="HeadersVisibility" Value="Column" />
            <Setter Property="CanUserAddRows" Value="False" />
            <Setter Property="IsReadOnly" Value="True" />
            <Setter Property="AutoGenerateColumns" Value="True" />
            <Setter Property="RowHeight" Value="38" />
        </Style>
        <Style TargetType="DatePicker">
            <Setter Property="Height" Value="38" />
            <Setter Property="Margin" Value="0,4,0,12" />
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="238" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <Border Grid.Column="0" Background="#241A35">
            <DockPanel LastChildFill="True">
                <StackPanel DockPanel.Dock="Top" Margin="22,24,22,18">
                    <Border Width="42" Height="42" CornerRadius="13" Background="#7047EB" HorizontalAlignment="Left">
                        <TextBlock Text="SC" Foreground="White" FontSize="17" FontWeight="Bold"
                                   HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <TextBlock Text="StableCare" Foreground="White" FontSize="20" FontWeight="Bold" Margin="0,14,0,2" />
                    <TextBlock Text="QUẢN LÝ CHĂM SÓC NGỰA" Foreground="#A79BB8" FontSize="9" />
                </StackPanel>

                <StackPanel Margin="12,12,12,0">
                    <TextBlock Text="MENU" Foreground="#9589A6" FontSize="10" FontWeight="Bold" Margin="14,0,0,9" />
                    <Button Style="{StaticResource NavButton}" Content="◈   Tổng quan" Click="ShowOverview_Click" />
                    <Button Style="{StaticResource NavButton}" Content="♞   Hồ sơ ngựa" Click="ShowHorses_Click" />
                    <Button Style="{StaticResource NavButton}" Content="◷   Lịch huấn luyện" Click="ShowTraining_Click" />
                    <Button Style="{StaticResource NavButton}" Content="✚   Sức khỏe &amp; thú y" Click="ShowHealth_Click" />
                </StackPanel>

                <Border DockPanel.Dock="Bottom" Margin="18" Padding="12" Background="#302642" CornerRadius="10">
                    <StackPanel>
                        <TextBlock Text="ĐỒ ÁN PRN212" Foreground="White" FontWeight="SemiBold" />
                        <TextBlock Text="WPF • C# • SQL Server" Foreground="#B6AFC2" FontSize="11" Margin="0,4,0,0" />
                    </StackPanel>
                </Border>
            </DockPanel>
        </Border>

        <Grid Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="76" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <Border Grid.Row="0" Background="White" BorderBrush="#ECE8F2" BorderThickness="0,0,0,1">
                <Grid Margin="28,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock x:Name="PageTitle" Text="Tổng quan" Foreground="{StaticResource Ink}"
                                   FontSize="20" FontWeight="Bold" />
                        <TextBlock Text="Theo dõi ngựa, lịch tập và sức khỏe trong một nơi"
                                   Foreground="{StaticResource Muted}" FontSize="12" Margin="0,3,0,0" />
                    </StackPanel>
                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="Vai trò demo" Foreground="{StaticResource Muted}" VerticalAlignment="Center" Margin="0,0,10,0" />
                        <ComboBox x:Name="RoleComboBox" Width="190" Height="38" SelectedIndex="0"
                                  SelectionChanged="RoleComboBox_SelectionChanged">
                            <ComboBoxItem Content="Quản trị viên" Tag="Admin" />
                            <ComboBoxItem Content="Chủ ngựa" Tag="Owner" />
                            <ComboBoxItem Content="Huấn luyện viên" Tag="Trainer" />
                            <ComboBoxItem Content="Bác sĩ thú y" Tag="Doctor" />
                        </ComboBox>
                    </StackPanel>
                </Grid>
            </Border>

            <TabControl x:Name="Pages" Grid.Row="1" Background="#F6F4FA" BorderThickness="0">
                <TabControl.ItemContainerStyle>
                    <Style TargetType="TabItem">
                        <Setter Property="Visibility" Value="Collapsed" />
                    </Style>
                </TabControl.ItemContainerStyle>
                <TabItem>
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <StackPanel Margin="30">
                            <TextBlock Text="Xin chào! 👋" Foreground="{StaticResource Ink}" FontSize="25" FontWeight="Bold" />
                            <TextBlock Text="Đây là tổng quan hoạt động tại chuồng ngựa của bạn."
                                       Foreground="{StaticResource Muted}" Margin="0,6,0,24" />
                            <UniformGrid Columns="3" Margin="0,0,0,22">
                                <Border Background="White" CornerRadius="12" Padding="20" Margin="0,0,14,0">
                                    <StackPanel>
                                        <TextBlock Text="TỔNG SỐ NGỰA" Foreground="{StaticResource Muted}" FontSize="11" FontWeight="Bold" />
                                        <TextBlock x:Name="HorseCountText" Text="—" Foreground="{StaticResource Ink}" FontSize="30" FontWeight="Bold" Margin="0,8,0,0" />
                                        <TextBlock Text="Hồ sơ đang được quản lý" Foreground="{StaticResource Muted}" FontSize="12" />
                                    </StackPanel>
                                </Border>
                                <Border Background="White" CornerRadius="12" Padding="20" Margin="0,0,14,0">
                                    <StackPanel>
                                        <TextBlock Text="BUỔI HUẤN LUYỆN" Foreground="{StaticResource Muted}" FontSize="11" FontWeight="Bold" />
                                        <TextBlock x:Name="TrainingCountText" Text="—" Foreground="{StaticResource Ink}" FontSize="30" FontWeight="Bold" Margin="0,8,0,0" />
                                        <TextBlock Text="Lịch tập đã ghi nhận" Foreground="{StaticResource Muted}" FontSize="12" />
                                    </StackPanel>
                                </Border>
                                <Border Background="White" CornerRadius="12" Padding="20">
                                    <StackPanel>
                                        <TextBlock Text="HỒ SƠ THÚ Y" Foreground="{StaticResource Muted}" FontSize="11" FontWeight="Bold" />
                                        <TextBlock x:Name="HealthCountText" Text="—" Foreground="{StaticResource Ink}" FontSize="30" FontWeight="Bold" Margin="0,8,0,0" />
                                        <TextBlock Text="Lần khám và điều trị" Foreground="{StaticResource Muted}" FontSize="12" />
                                    </StackPanel>
                                </Border>
                            </UniformGrid>
                            <Border Background="White" CornerRadius="12" Padding="22">
                                <StackPanel>
                                    <TextBlock Text="Bắt đầu nhanh" Foreground="{StaticResource Ink}" FontSize="16" FontWeight="Bold" />
                                    <TextBlock Text="• Quản trị viên / Chủ ngựa: tạo hồ sơ ngựa và gán chủ sở hữu."
                                               Foreground="{StaticResource Muted}" Margin="0,12,0,4" />
                                    <TextBlock Text="• Huấn luyện viên: lập lịch, ghi nhận nội dung và thời lượng tập."
                                               Foreground="{StaticResource Muted}" Margin="0,4" />
                                    <TextBlock Text="• Bác sĩ thú y: lưu chẩn đoán và phương án điều trị."
                                               Foreground="{StaticResource Muted}" Margin="0,4,0,0" />
                                </StackPanel>
                            </Border>
                            <TextBlock x:Name="StatusText" Text="Đang kết nối cơ sở dữ liệu..."
                                       Foreground="{StaticResource Muted}" FontSize="12" Margin="2,16,0,0" />
                        </StackPanel>
                    </ScrollViewer>
                </TabItem>

                <TabItem>
                    <Grid Margin="26">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="340" />
                        </Grid.ColumnDefinitions>
                        <Border Background="White" CornerRadius="12" Padding="14" Margin="0,0,18,0">
                            <DataGrid x:Name="HorsesGrid" />
                        </Border>
                        <Border Grid.Column="1" Background="White" CornerRadius="12" Padding="20">
                            <ScrollViewer VerticalScrollBarVisibility="Auto">
                                <StackPanel>
                                    <TextBlock Text="Thêm hồ sơ ngựa" Foreground="{StaticResource Ink}" FontSize="17" FontWeight="Bold" />
                                    <TextBlock Text="Tên ngựa *" Foreground="{StaticResource Muted}" />
                                    <TextBox x:Name="HorseNameBox" Style="{StaticResource Field}" />
                                    <TextBlock Text="Giống ngựa" Foreground="{StaticResource Muted}" />
                                    <TextBox x:Name="BreedBox" Style="{StaticResource Field}" />
                                    <TextBlock Text="Giới tính" Foreground="{StaticResource Muted}" />
                                    <ComboBox x:Name="SexComboBox" Style="{StaticResource FieldCombo}" SelectedIndex="0">
                                        <ComboBoxItem Content="Cái" />
                                        <ComboBoxItem Content="Đực" />
                                        <ComboBoxItem Content="Chưa rõ" />
                                    </ComboBox>
                                    <TextBlock Text="Ngày sinh" Foreground="{StaticResource Muted}" />
                                    <DatePicker x:Name="BirthDatePicker" />
                                    <TextBlock Text="Chủ ngựa" Foreground="{StaticResource Muted}" />
                                    <ComboBox x:Name="OwnerComboBox" Style="{StaticResource FieldCombo}"
                                              DisplayMemberPath="DisplayName" />
                                    <Separator Margin="0,3,0,12" />
                                    <TextBlock Text="Tạo chủ sở hữu mới (Quản trị viên)" Foreground="{StaticResource Ink}"
                                               FontSize="14" FontWeight="SemiBold" />
                                    <TextBlock Text="Họ và tên *" Foreground="{StaticResource Muted}" Margin="0,8,0,0" />
                                    <TextBox x:Name="OwnerNameBox" Style="{StaticResource Field}" />
                                    <TextBlock Text="Email *" Foreground="{StaticResource Muted}" />
                                    <TextBox x:Name="OwnerEmailBox" Style="{StaticResource Field}" />
                                    <Button x:Name="AddOwnerButton" Content="Tạo chủ sở hữu" Style="{StaticResource PrimaryButton}"
                                            Click="AddOwner_Click" Margin="0,0,0,12" />
                                    <TextBlock Text="Danh sách chủ sở hữu" Foreground="{StaticResource Ink}"
                                               FontSize="14" FontWeight="SemiBold" Margin="0,2,0,8" />
                                    <DataGrid x:Name="OwnersGrid" Height="155" MinHeight="120"
                                              AutoGenerateColumns="True" />
                                    <TextBlock Text="Ghi chú" Foreground="{StaticResource Muted}" />
                                    <TextBox x:Name="HorseNotesBox" Height="62" AcceptsReturn="True" TextWrapping="Wrap"
                                             VerticalContentAlignment="Top" Padding="10" Margin="0,4,0,14"
                                             BorderBrush="#DED8E9" />
                                    <Button x:Name="AddHorseButton" Content="Lưu hồ sơ ngựa" Style="{StaticResource PrimaryButton}"
                                            Click="AddHorse_Click" />
                                </StackPanel>
                            </ScrollViewer>
                        </Border>
                    </Grid>
                </TabItem>

                <TabItem>
                    <Grid Margin="26">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="340" />
                        </Grid.ColumnDefinitions>
                        <Border Background="White" CornerRadius="12" Padding="14" Margin="0,0,18,0">
                            <DataGrid x:Name="TrainingGrid" />
                        </Border>
                        <Border Grid.Column="1" Background="White" CornerRadius="12" Padding="20">
                            <ScrollViewer VerticalScrollBarVisibility="Auto">
                                <StackPanel>
                                    <TextBlock Text="Lập lịch huấn luyện" Foreground="{StaticResource Ink}" FontSize="17" FontWeight="Bold" />
                                    <TextBlock Text="Ngựa *" Foreground="{StaticResource Muted}" Margin="0,12,0,0" />
                                    <ComboBox x:Name="TrainingHorseComboBox" Style="{StaticResource FieldCombo}"
                                              DisplayMemberPath="Name" />
                                    <TextBlock Text="Ngày và giờ *" Foreground="{StaticResource Muted}" />
                                    <DatePicker x:Name="TrainingDatePicker" />
                                    <TextBlock Text="Nội dung buổi tập *" Foreground="{StaticResource Muted}" />
                                    <TextBox x:Name="ActivityBox" Style="{StaticResource Field}" />
                                    <TextBlock Text="Thời lượng (phút)" Foreground="{StaticResource Muted}" />
                                    <TextBox x:Name="DurationBox" Style="{StaticResource Field}" Text="60" />
                                    <TextBlock Text="Ghi chú" Foreground="{StaticResource Muted}" />
                                    <TextBox x:Name="TrainingNotesBox" Height="72" AcceptsReturn="True" TextWrapping="Wrap"
                                             VerticalContentAlignment="Top" Padding="10" Margin="0,4,0,14"
                                             BorderBrush="#DED8E9" />
                                    <Button x:Name="AddTrainingButton" Content="Lưu lịch huấn luyện" Style="{StaticResource PrimaryButton}"
                                            Click="AddTraining_Click" />
                                </StackPanel>
                            </ScrollViewer>
                        </Border>
                    </Grid>
                </TabItem>

                <TabItem>
                    <Grid Margin="26">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="340" />
                        </Grid.ColumnDefinitions>
                        <Border Background="White" CornerRadius="12" Padding="14" Margin="0,0,18,0">
                            <DataGrid x:Name="HealthGrid" />
                        </Border>
                        <Border Grid.Column="1" Background="White" CornerRadius="12" Padding="20">
                            <ScrollViewer VerticalScrollBarVisibility="Auto">
                                <StackPanel>
                                    <TextBlock Text="Ghi hồ sơ sức khỏe" Foreground="{StaticResource Ink}" FontSize="17" FontWeight="Bold" />
                                    <TextBlock Text="Ngựa *" Foreground="{StaticResource Muted}" Margin="0,12,0,0" />
                                    <ComboBox x:Name="HealthHorseComboBox" Style="{StaticResource FieldCombo}"
                                              DisplayMemberPath="Name" />
                                    <TextBlock Text="Ngày khám *" Foreground="{StaticResource Muted}" />
                                    <DatePicker x:Name="VisitDatePicker" />
                                    <TextBlock Text="Chẩn đoán *" Foreground="{StaticResource Muted}" />
                                    <TextBox x:Name="DiagnosisBox" Style="{StaticResource Field}" />
                                    <TextBlock Text="Điều trị / thuốc" Foreground="{StaticResource Muted}" />
                                    <TextBox x:Name="TreatmentBox" Height="72" AcceptsReturn="True" TextWrapping="Wrap"
                                             VerticalContentAlignment="Top" Padding="10" Margin="0,4,0,14"
                                             BorderBrush="#DED8E9" />
                                    <TextBlock Text="Tình trạng" Foreground="{StaticResource Muted}" />
                                    <ComboBox x:Name="HealthStatusComboBox" Style="{StaticResource FieldCombo}" SelectedIndex="0">
                                        <ComboBoxItem Content="Đang theo dõi" />
                                        <ComboBoxItem Content="Đã hồi phục" />
                                        <ComboBoxItem Content="Cần tái khám" />
                                    </ComboBox>
                                    <Button x:Name="AddHealthButton" Content="Lưu hồ sơ thú y" Style="{StaticResource PrimaryButton}"
                                            Click="AddHealth_Click" />
                                </StackPanel>
                            </ScrollViewer>
                        </Border>
                    </Grid>
                </TabItem>
            </TabControl>
        </Grid>
    </Grid>
</Window>
